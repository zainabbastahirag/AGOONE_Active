        <mxCell id="leg2t" value="Auth request to Entra ID" style="text;html=1;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="-40" y="685" width="160" height="20" as="geometry" />
        </mxCell>

        <mxCell id="leg3" value="" style="endArrow=classic;strokeColor=#CC0000;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-120" y="725" as="sourcePoint" />
            <mxPoint x="-50" y="725" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="leg3t" value="Token response / DB write" style="text;html=1;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="-40" y="715" width="160" height="20" as="geometry" />
        </mxCell>

        <mxCell id="leg4" value="" style="endArrow=classic;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-120" y="755" as="sourcePoint" />
            <mxPoint x="-50" y="755" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="leg4t" value="Cross-product SSO navigation" style="text;html=1;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="-40" y="745" width="180" height="20" as="geometry" />
        </mxCell>

        <mxCell id="leg5" value="" style="endArrow=classic;strokeColor=#CC0000;strokeWidth=2;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-120" y="785" as="sourcePoint" />
            <mxPoint x="-50" y="785" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="leg5t" value="Blocked / redirect to Portal" style="text;html=1;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="-40" y="775" width="160" height="20" as="geometry" />
        </mxCell>

        <mxCell id="leg-note" value="&lt;b&gt;KEY RULE:&lt;/b&gt;&lt;br&gt;Portal: RedirectToPortal = &lt;b&gt;false&lt;/b&gt;&lt;br&gt;All others: RedirectToPortal = &lt;b&gt;true&lt;/b&gt;&lt;br&gt;&lt;br&gt;This makes products redirect&lt;br&gt;to Portal when not logged in." style="text;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="-130" y="810" width="260" height="105" as="geometry" />
