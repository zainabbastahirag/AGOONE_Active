{
  "// INSTRUCTIONS": "Merge this into your AG ONE Work API's appsettings.json",

  "AzureAd": {
    "Instance": "https://YOUR-TENANT.ciamlogin.com/",
    "TenantId": "YOUR-TENANT-ID",
    "ClientId": "YOUR-WORK-API-CLIENT-ID",
    "Audience": "api://YOUR-WORK-API-CLIENT-ID",
    "Domain": "YOUR-TENANT.onmicrosoft.com",
    "SignUpSignInPolicyId": "B2C_1_SignUpSignIn"
  },

  "AgOneSso": {
    "ProductName": "Work",
    "ValidateIssuer": true,
    "ValidIssuers": [
      "https://YOUR-TENANT.ciamlogin.com/YOUR-TENANT-ID/v2.0",
      "https://login.microsoftonline.com/YOUR-TENANT-ID/v2.0"
    ],
    "AllowedOrigins": [
      "https://portal.yourdomain.com",
      "https://learn.yourdomain.com",
      "https://safe.yourdomain.com",
      "https://work.yourdomain.com",
      "https://pulse.yourdomain.com"
    ]
  }
}
