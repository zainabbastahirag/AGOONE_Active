        <mxCell id="t2" value="AG ONE SSO — Login + Cross-Product Flow" style="text;html=1;fontSize=22;fontStyle=1;align=center;fillColor=none;strokeColor=none;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="350" y="10" width="600" height="35" as="geometry" />
        </mxCell>

        <!-- Swimlane Headers -->
        <mxCell id="swim-user" value="USER" style="text;html=1;fontSize=13;fontStyle=1;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="swim-portal-ui" value="PORTAL UI" style="text;html=1;fontSize=13;fontStyle=1;align=center;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="60" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="swim-entra" value="ENTRA ID" style="text;html=1;fontSize=13;fontStyle=1;align=center;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="60" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="swim-portal-api" value="PORTAL API" style="text;html=1;fontSize=13;fontStyle=1;align=center;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="60" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="swim-db" value="DATABASE" style="text;html=1;fontSize=13;fontStyle=1;align=center;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="870" y="60" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="swim-learn-ui" value="LEARN UI" style="text;html=1;fontSize=13;fontStyle=1;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="60" width="120" height="30" as="geometry" />
        </mxCell>

        <!-- Vertical lines -->
        <mxCell id="vl1" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#cccccc;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="100" y="95" as="sourcePoint" /><mxPoint x="100" y="1080" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="vl2" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#cccccc;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="280" y="95" as="sourcePoint" /><mxPoint x="280" y="1080" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="vl3" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#cccccc;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="500" y="95" as="sourcePoint" /><mxPoint x="500" y="1080" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="vl4" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#cccccc;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="720" y="95" as="sourcePoint" /><mxPoint x="720" y="1080" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="vl5" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#cccccc;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="930" y="95" as="sourcePoint" /><mxPoint x="930" y="1080" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="vl6" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#cccccc;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="95" as="sourcePoint" /><mxPoint x="1140" y="1080" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- === SECTION 1: LOGIN === -->
        <mxCell id="sec1" value="PHASE 1: FIRST LOGIN" style="text;html=1;fontSize=12;fontStyle=5;align=left;fillColor=#1a1a2e;strokeColor=none;fontColor=#ffffff;rounded=1;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="105" width="1180" height="25" as="geometry" />
        </mxCell>

        <!-- Step 1 -->
        <mxCell id="s1" value="1. Visit&#xa;portal.agone.com" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="45" y="145" width="110" height="45" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="" style="endArrow=classic;html=1;strokeColor=#2980b9;strokeWidth=2;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="2. App.razor loads&#xa;AuthorizeRouteView&#xa;→ Not authenticated&#xa;→ AgOneRedirectToLogin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="210" y="140" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="MSAL redirect" style="endArrow=classic;html=1;strokeColor=#2980b9;strokeWidth=2;fontSize=9;fontColor=#2980b9;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="3. Entra ID&#xa;login page&#xa;(your existing&#xa;SignUp/SignIn flow)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="435" y="140" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="" style="endArrow=classic;html=1;strokeColor=#2980b9;strokeWidth=1;dashed=1;" edge="1" parent="1" source="s3" target="s3b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3b" value="User enters&#xa;email + password" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="45" y="220" width="110" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a3b" value="" style="endArrow=classic;html=1;strokeColor=#27ae60;strokeWidth=2;" edge="1" parent="1" source="s3b" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="4. Entra ID validates&#xa;→ Creates SSO COOKIE&#xa;→ Returns tokens:&#xa;access_token (1h)&#xa;refresh_token (24-90d)&#xa;id_token (1h)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="415" y="215" width="170" height="85" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="redirect + tokens" style="endArrow=classic;html=1;strokeColor=#27ae60;strokeWidth=2;fontSize=9;fontColor=#27ae60;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="5. MSAL stores tokens&#xa;in browser localStorage&#xa;&#xa;App.razor renders&#xa;(user is now logged in)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="210" y="315" width="140" height="75" as="geometry" />
        </mxCell>

        <!-- === SECTION 2: API CALL === -->
        <mxCell id="sec2" value="PHASE 2: API CALL + TOKEN SAVED TO DB" style="text;html=1;fontSize=12;fontStyle=5;align=left;fillColor=#1a1a2e;strokeColor=none;fontColor=#ffffff;rounded=1;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="405" width="1180" height="25" as="geometry" />
        </mxCell>

        <mxCell id="s6" value="6. User clicks&#xa;&quot;Load data&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="45" y="445" width="110" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="" style="endArrow=classic;html=1;strokeColor=#2980b9;strokeWidth=2;" edge="1" parent="1" source="s6" target="s7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="7. AuthorizationHandler&#xa;attaches Bearer token&#xa;to HTTP request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="210" y="440" width="140" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="Bearer eyJ..." style="endArrow=classic;html=1;strokeColor=#2980b9;strokeWidth=2;fontSize=9;fontColor=#2980b9;" edge="1" parent="1" source="s7" target="s8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="8. JWT validated&#xa;→ TokenCaptureMiddleware&#xa;   extracts token&#xa;→ Controller runs&#xa;→ Returns response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="640" y="435" width="160" height="75" as="geometry" />
        </mxCell>
        <mxCell id="a8" value="9. Save token" style="endArrow=classic;html=1;strokeColor=#c0392b;strokeWidth=2;fontSize=9;fontColor=#c0392b;" edge="1" parent="1" source="s8" target="s9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s9" value="9. INSERT/UPDATE&#xa;UserTokens&#xa;(UserId, Product=Portal&#xa; AccessToken, Expiry)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="855" y="440" width="150" height="65" as="geometry" />
        </mxCell>

        <!-- === SECTION 3: CROSS-PRODUCT SSO === -->
        <mxCell id="sec3" value="PHASE 3: CROSS-PRODUCT SSO (Portal → Learn) — NO LOGIN PAGE SHOWN" style="text;html=1;fontSize=12;fontStyle=5;align=left;fillColor=#1a1a2e;strokeColor=none;fontColor=#ffffff;rounded=1;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="1180" height="25" as="geometry" />
        </mxCell>

        <mxCell id="s10" value="10. User clicks&#xa;&quot;Go to Learn&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="45" y="570" width="110" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a10" value="" style="endArrow=classic;html=1;strokeColor=#e67e22;strokeWidth=2;" edge="1" parent="1" source="s10" target="s11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s11" value="11. NavigateToProduct&#xa;→ browser goes to&#xa;learn.agone.com" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="210" y="565" width="140" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a11" value="forceLoad: true" style="endArrow=classic;html=1;strokeColor=#e67e22;strokeWidth=2;fontSize=9;fontColor=#e67e22;" edge="1" parent="1" source="s11" target="s12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s12" value="12. Learn UI loads&#xa;MSAL: no local token&#xa;→ TrySilentLoginAsync()&#xa;→ Hidden iframe to&#xa;   Entra ID (prompt=none)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1060" y="560" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a12" value="iframe + SSO cookie" style="endArrow=classic;html=1;strokeColor=#8e44ad;strokeWidth=2;fontSize=9;fontColor=#8e44ad;curved=1;" edge="1" parent="1" source="s12" target="s13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s13" value="13. Entra ID checks&#xa;SSO COOKIE&#xa;→ Cookie EXISTS!&#xa;  (from Portal login)&#xa;→ Issues new tokens&#xa;   for Learn silently" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="415" y="660" width="170" height="85" as="geometry" />
        </mxCell>
        <mxCell id="a13" value="tokens (no login page!)" style="endArrow=classic;html=1;strokeColor=#27ae60;strokeWidth=2;fontSize=9;fontColor=#27ae60;curved=1;" edge="1" parent="1" source="s13" target="s14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s14" value="14. Learn has tokens!&#xa;User sees Learn app&#xa;(never saw a login page)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="665" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- === SECTION 4: TOKEN REFRESH === -->
        <mxCell id="sec4" value="PHASE 4: TOKEN REFRESH (~55 minutes later, automatic)" style="text;html=1;fontSize=12;fontStyle=5;align=left;fillColor=#1a1a2e;strokeColor=none;fontColor=#ffffff;rounded=1;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="770" width="1180" height="25" as="geometry" />
        </mxCell>

        <mxCell id="s15" value="15. Token expiring&#xa;MSAL.js detects&#xa;(&lt;5 min left)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="210" y="810" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a15" value="silent iframe&#xa;OR refresh_token" style="endArrow=classic;html=1;strokeColor=#8e44ad;strokeWidth=2;fontSize=9;fontColor=#8e44ad;" edge="1" parent="1" source="s15" target="s16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s16" value="16. Entra ID&#xa;validates SSO cookie&#xa;or refresh_token&#xa;→ Issues NEW tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="430" y="805" width="140" height="65" as="geometry" />
        </mxCell>
        <mxCell id="a16" value="new tokens" style="endArrow=classic;html=1;strokeColor=#27ae60;strokeWidth=2;fontSize=9;fontColor=#27ae60;" edge="1" parent="1" source="s16" target="s17">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s17" value="17. MSAL updates&#xa;localStorage with&#xa;new tokens.&#xa;User sees nothing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="210" y="885" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a17" value="next API call →" style="endArrow=classic;html=1;strokeColor=#2980b9;strokeWidth=1;fontSize=9;fontColor=#2980b9;" edge="1" parent="1" source="s17" target="s18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s18" value="18. New token sent&#xa;→ TokenCaptureMiddleware&#xa;→ DB updated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="640" y="890" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a18" value="UPDATE" style="endArrow=classic;html=1;strokeColor=#c0392b;strokeWidth=2;fontSize=9;fontColor=#c0392b;" edge="1" parent="1" source="s18" target="s19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s19" value="19. UPDATE UserTokens&#xa;SET AccessToken=NEW&#xa;RefreshCount + 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="865" y="888" width="140" height="55" as="geometry" />
        </mxCell>

        <!-- === SECTION 5: LOGOUT === -->
        <mxCell id="sec5" value="PHASE 5: LOGOUT (clears everything across ALL products)" style="text;html=1;fontSize=12;fontStyle=5;align=left;fillColor=#1a1a2e;strokeColor=none;fontColor=#ffffff;rounded=1;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="960" width="1180" height="25" as="geometry" />
        </mxCell>
        <mxCell id="s20" value="20. Click Logout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="45" y="1000" width="110" height="35" as="geometry" />
        </mxCell>
        <mxCell id="a20" value="" style="endArrow=classic;html=1;strokeColor=#c0392b;strokeWidth=2;" edge="1" parent="1" source="s20" target="s21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s21" value="21. MSAL clears&#xa;localStorage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="215" y="995" width="130" height="45" as="geometry" />
        </mxCell>
        <mxCell id="a21" value="delete cookie" style="endArrow=classic;html=1;strokeColor=#c0392b;strokeWidth=2;fontSize=9;fontColor=#c0392b;" edge="1" parent="1" source="s21" target="s22">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s22" value="22. Entra ID&#xa;DELETES SSO cookie&#xa;(all products lose SSO)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="425" y="993" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a22" value="POST /logout" style="endArrow=classic;html=1;strokeColor=#c0392b;strokeWidth=1;fontSize=9;fontColor=#c0392b;" edge="1" parent="1" source="s21" target="s23">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s23" value="23. AgOneAuthController&#xa;Logout(allProducts=true)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="640" y="1000" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a23" value="" style="endArrow=classic;html=1;strokeColor=#c0392b;strokeWidth=2;" edge="1" parent="1" source="s23" target="s24">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s24" value="24. UPDATE UserTokens&#xa;SET IsActive=0&#xa;WHERE UserId=@id&#xa;(ALL products at once)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="855" y="990" width="150" height="60" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="direct-url-blocked" name="3 - Direct URL Blocked">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t3" value="AG ONE SSO — Direct URL Access Blocked (user not logged in)" style="text;html=1;fontSize=20;fontStyle=1;align=center;fillColor=none;strokeColor=none;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="200" y="10" width="700" height="35" as="geometry" />
        </mxCell>

        <mxCell id="b1" value="1. User types&#xa;learn.agone.com&#xa;in browser directly&#xa;(NOT logged in)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ba1" value="" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#e67e22;" edge="1" parent="1" source="b1" target="b2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="2. Learn UI loads&#xa;AuthorizeRouteView&#xa;→ Not authenticated&#xa;→ TrySilentLoginAsync()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="75" width="170" height="75" as="geometry" />
        </mxCell>
        <mxCell id="ba2" value="iframe prompt=none" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#8e44ad;fontSize=9;fontColor=#8e44ad;" edge="1" parent="1" source="b2" target="b3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="3. Entra ID:&#xa;No SSO cookie found!&#xa;Returns error:&#xa;interaction_required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="500" y="75" width="170" height="75" as="geometry" />
        </mxCell>
        <mxCell id="ba3" value="FAIL" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#c0392b;fontSize=10;fontColor=#c0392b;fontStyle=1;" edge="1" parent="1" source="b3" target="b4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="4. Silent login FAILED&#xa;&#xa;Learn config:&#xa;RedirectToPortal = true&#xa;↓&#xa;AgOneSsoService.Login()&#xa;redirects to Portal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="260" y="200" width="170" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ba4" value="redirect to portal.agone.com&#xa;?returnUrl=learn.agone.com" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#e67e22;fontSize=9;fontColor=#e67e22;" edge="1" parent="1" source="b4" target="b5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="5. Portal loads&#xa;→ Same flow as Phase 1&#xa;→ User sees Entra ID&#xa;   login page&#xa;→ Enters credentials" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="500" y="210" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ba5" value="login success →&#xa;SSO cookie created" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#27ae60;fontSize=9;fontColor=#27ae60;" edge="1" parent="1" source="b5" target="b6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b6" value="6. Portal sees returnUrl&#xa;→ Redirects back to:&#xa;learn.agone.com" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="740" y="210" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ba6" value="" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#e67e22;" edge="1" parent="1" source="b6" target="b7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b7" value="7. Learn loads again&#xa;→ TrySilentLoginAsync()&#xa;→ iframe to Entra ID&#xa;→ SSO COOKIE EXISTS NOW!&#xa;→ Tokens issued silently&#xa;→ User sees Learn app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="340" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b-result" value="RESULT: User could NOT access Learn directly.&#xa;They were forced to login via Portal first.&#xa;After login, they were sent back to Learn automatically." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="490" width="600" height="50" as="geometry" />
