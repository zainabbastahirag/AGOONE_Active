@{ ViewData["Title"] = "Join Organization"; var invite = ViewBag.Invite as TeamTracker.Models.InviteLink; }

<div class="d-flex justify-content-center align-items-center" style="min-height:80vh;">
    <div style="max-width:480px; width:100%;">
        <div class="card" style="border-radius:14px;">
            <div class="card-body p-4 text-center">
                <i class="bi bi-envelope-open-fill text-primary" style="font-size:2.5rem;"></i>
                <h3 class="fw-bold mt-3">You're Invited!</h3>
                <p class="text-muted">
                    You've been invited to join <strong>@invite?.Organization?.Name</strong>
                    as a <span class="badge bg-primary">@invite?.Role</span>.
                </p>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <form asp-action="AcceptInvite" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="code" value="@invite?.Code" />
                        <button type="submit" class="btn btn-primary btn-lg w-100 mt-3" style="border-radius:10px;">
                            <i class="bi bi-check-circle-fill"></i> Accept & Join
                        </button>
                    </form>
                }
                else
                {
                    <a href="/Auth/Login?returnUrl=/Auth/Join/@(invite?.Code)" class="btn btn-primary btn-lg w-100 mt-3" style="border-radius:10px;">
                        <i class="bi bi-google"></i> Sign in with Google to Join
                    </a>
                }
            </div>
        </div>
    </div>
</div>
