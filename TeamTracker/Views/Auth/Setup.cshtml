@{ ViewData["Title"] = "Setup Organization"; }

<div class="d-flex justify-content-center align-items-center" style="min-height:80vh;">
    <div style="max-width:500px; width:100%;">
        <div class="text-center mb-4">
            <h2 class="fw-bold" style="color:#0f172a;">Welcome to Kpi<span style="color:#6366f1;">Pulse</span></h2>
            <p class="text-muted">Set up your organization to get started. You can invite others later.</p>
        </div>

        <div class="card" style="border-radius:14px;">
            <div class="card-body p-4">
                <form asp-action="Setup" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Organization Name</label>
                        <input type="text" name="orgName" class="form-control form-control-lg" placeholder="e.g. AGONE Tech Team" required />
                        <small class="text-muted">This is your team/company workspace name</small>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-100" style="border-radius:10px;">
                        <i class="bi bi-rocket-takeoff-fill"></i> Create Organization
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
