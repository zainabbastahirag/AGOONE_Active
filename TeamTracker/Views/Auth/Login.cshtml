@{ ViewData["Title"] = "Sign In"; Layout = "_Layout"; }

<div class="d-flex justify-content-center align-items-center" style="min-height:100vh; background:linear-gradient(135deg,#0f172a 0%,#1e293b 100%);">
    <div class="text-center" style="max-width:420px; width:100%; padding:2rem;">
        <div style="margin-bottom:2rem;">
            <h1 style="font-size:2.5rem; font-weight:800; color:#fff; letter-spacing:-.03em;">
                Kpi<span style="color:#818cf8;">Pulse</span>
            </h1>
            <p style="color:rgba(255,255,255,.5); font-size:.9rem; margin-top:.25rem;">
                Lightweight Project & People Management
            </p>
        </div>

        <div class="card" style="border-radius:16px; border:none; box-shadow:0 20px 40px rgba(0,0,0,.3);">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-1" style="color:#0f172a;">Welcome</h4>
                <p class="text-muted small mb-4">Sign in with your Google account to continue</p>

                <form asp-controller="Auth" asp-action="GoogleLogin" method="post"
                      asp-route-returnUrl="@ViewBag.ReturnUrl">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-lg w-100 d-flex align-items-center justify-content-center gap-2"
                            style="background:#fff; border:2px solid #e2e8f0; color:#1e293b; font-weight:600; border-radius:12px; padding:.75rem;">
                        <svg width="20" height="20" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
                        Continue with Google
                    </button>
                </form>

                <p class="text-muted mt-4 mb-0" style="font-size:.72rem;">
                    By signing in, you agree to use KpiPulse for team management purposes.
                    <br/>Free and open source.
                </p>
            </div>
        </div>

        <details style="margin-top:1.5rem; text-align:left;">
            <summary style="color:rgba(255,255,255,.3); font-size:.7rem; cursor:pointer;">
                Developer: Show required Google Console redirect URI
            </summary>
            <div style="background:rgba(255,255,255,.08); padding:.75rem; border-radius:8px; margin-top:.5rem;">
                <p style="color:rgba(255,255,255,.5); font-size:.7rem; margin-bottom:.25rem;">
                    Add this <strong>exact</strong> URI to Google Cloud Console &gt; OAuth 2.0 &gt; Authorized redirect URIs:
                </p>
                <code style="color:#818cf8; font-size:.8rem; word-break:break-all;">
                    @Context.Request.Scheme://@Context.Request.Host/signin-google
                </code>
            </div>
        </details>

        <p style="color:rgba(255,255,255,.3); font-size:.7rem; margin-top:1rem;">
            KpiPulse &mdash; Free project & people management for tech teams
        </p>
    </div>
</div>
