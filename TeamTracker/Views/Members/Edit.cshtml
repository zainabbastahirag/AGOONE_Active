@model TeamTracker.Models.Member
@{ ViewData["Title"] = $"Edit — {Model.Name}"; }

<div class="top-header">
    <h3><i class="bi bi-pencil"></i> Edit — @Model.Name</h3>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="card" style="max-width:600px;">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label class="form-label">Name</label>
                <input asp-for="Name" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Team</label>
                <select asp-for="TeamId" asp-items="@ViewBag.Teams" class="form-select"></select>
            </div>
            <div class="mb-3">
                <label class="form-label">Role</label>
                <select asp-for="Role" class="form-select">
                    <option>Developer</option><option>Tech Lead</option><option>QA</option>
                    <option>UI/UX</option><option>Product</option><option>DevOps</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Projects Assigned</label>
                <input asp-for="ProjectsAssigned" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save</button>
        </form>
    </div>
</div>
