@model TeamTracker.Models.Member
@{ ViewData["Title"] = "Add Member"; }

<div class="top-header">
    <h3><i class="bi bi-person-plus"></i> Add Member</h3>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="card" style="max-width:600px;">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">Name</label>
                <input asp-for="Name" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Team</label>
                <select asp-for="TeamId" asp-items="@ViewBag.Teams" class="form-select">
                    <option value="">-- Select Team --</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Role</label>
                <select asp-for="Role" class="form-select">
                    <option>Developer</option><option>Tech Lead</option><option>QA</option>
                    <option>UI/UX</option><option>Product</option><option>DevOps</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Projects Assigned</label>
                <input asp-for="ProjectsAssigned" class="form-control" placeholder="e.g. AGONEWorkj, OJE Safe" />
                <small class="text-muted">Comma-separated if multiple projects</small>
            </div>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Add Member</button>
        </form>
    </div>
</div>
