@model TeamTracker.ViewModels.DailyLogEditViewModel
@{ViewData["Title"]="Add Daily Entry";}

<nav class="topnav"><a href="/" class="brand">Kpi<span>Pulse</span></a><div class="right"><a href="/" class="btn-exp"><i class="bi bi-arrow-left"></i> Dashboard</a></div></nav>
<div class="subnav">
    <a href="/" class="back-btn"><i class="bi bi-chevron-left"></i> Back</a>
    <div class="breadcrumb-trail"><a href="/">Dashboard</a><span class="sep">/</span><span>Daily Log</span><span class="sep">/</span><span>New Entry</span></div>
</div>

<div class="app-c" style="max-width:650px;">
    <div style="background:var(--card);border-radius:var(--rd);box-shadow:var(--sh2);overflow:hidden;">
        <div style="background:linear-gradient(135deg,#0f172a,#1e293b);color:#fff;padding:.85rem 1rem;">
            <h5 style="font-weight:700;font-size:.95rem;margin:0;"><i class="bi bi-plus-circle"></i> Add Daily Entry</h5>
        </div>
        <div style="padding:1rem;">
            <form asp-action="Create" method="post">@Html.AntiForgeryToken()
                <div class="row g-2 mb-3">
                    <div class="col-6 col-md-4"><label class="form-label">Date</label><input type="date" asp-for="Log.Date" class="form-control form-control-sm"/></div>
                    <div class="col-6 col-md-4"><label class="form-label">Member</label><select asp-for="Log.MemberId" asp-items="Model.Members" class="form-select form-select-sm"><option value="">Select</option></select></div>
                    <div class="col-12 col-md-4"><label class="form-label">Project</label><select asp-for="Log.Project" asp-items="Model.Projects" class="form-select form-select-sm"><option value="">Select</option></select></div>
                    <div class="col-6 col-md-4"><label class="form-label">Ticket #</label><input asp-for="Log.TaskTicket" class="form-control form-control-sm" placeholder="JIRA-123"/></div>
                    <div class="col-12 col-md-8"><label class="form-label">Task Description</label><input asp-for="Log.TaskDescription" class="form-control form-control-sm" placeholder="What was done"/></div>
                    <div class="col-6 col-md-4"><label class="form-label">Status</label><select asp-for="Log.Status" class="form-select form-select-sm">@foreach(var s in TeamTracker.Models.DailyLog.StatusOptions){<option value="@s">@s</option>}</select></div>
                    <div class="col-3 col-md-4"><label class="form-label">Hours</label><input type="number" asp-for="Log.HoursWorked" class="form-control form-control-sm" step="0.5" min="0" max="24"/></div>
                    <div class="col-3 col-md-4"><label class="form-label">Extra</label><input type="number" asp-for="Log.ExtraHours" class="form-control form-control-sm" step="0.5" min="0"/></div>
                    <div class="col-12"><label class="form-label">Blockers</label><textarea asp-for="Log.Blockers" class="form-control form-control-sm" rows="1" placeholder="Any blockers?"></textarea></div>
                    <div class="col-12"><label class="form-label">Notes</label><textarea asp-for="Log.Notes" class="form-control form-control-sm" rows="1" placeholder="Notes"></textarea></div>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn-a" style="flex:1;justify-content:center;padding:.5rem;"><i class="bi bi-check-lg"></i> Save Entry</button>
                    <a href="/" class="btn-g" style="padding:.5rem .7rem;">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
