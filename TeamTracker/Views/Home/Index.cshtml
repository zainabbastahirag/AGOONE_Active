@model TeamTracker.ViewModels.DashboardViewModel
@{
    ViewData["Title"]="Dashboard";
    var u=ViewBag.CurrentUser as TeamTracker.Models.AppUser;
    var canEdit=(bool)(ViewBag.CanEdit??false);
    var ai=ViewBag.AiReport as TeamTracker.Services.AiInsightEngine.AiReport;
    var inviteLinks=ViewBag.InviteLinks as List<TeamTracker.Models.InviteLink>??new();
    var orgMembers=ViewBag.OrgMembers as List<TeamTracker.Models.AppUser>??new();
    var tc=new[]{"#6366f1","#dc2626","#059669","#d97706","#7c3aed","#ea580c","#0d9488"};
}

<!-- ═══ TOP NAV ═══ -->
<nav class="topnav">
    <div style="display:flex;align-items:center;">
        <a href="/" class="brand">Kpi<span>Pulse</span></a>
        <div class="nav-links">
            <a href="#" class="active" onclick="go('tp-ai',this,0);return false;"><i class="bi bi-stars"></i> AI Insights</a>
            <a href="#" onclick="go('tp-teams',this,1);return false;"><i class="bi bi-diagram-3"></i> Teams</a>
            <a href="#" onclick="go('tp-kpi',this,2);return false;"><i class="bi bi-graph-up-arrow"></i> KPIs</a>
            <a href="#" onclick="go('tp-log',this,3);return false;"><i class="bi bi-journal-text"></i> Daily Log</a>
            <a href="#" onclick="go('tp-fb',this,4);return false;"><i class="bi bi-chat-dots"></i> Feedback</a>
            <a href="#" onclick="go('tp-inv',this,5);return false;"><i class="bi bi-link-45deg"></i> Invite</a>
        </div>
    </div>
    <div class="right">
        <a href="/Export/FullReport?month=@Model.SelectedMonth&year=@Model.SelectedYear" class="btn-exp"><i class="bi bi-file-earmark-excel"></i><span class="d-none d-md-inline">Excel</span></a>
        <div class="user-pill">
            @if(u?.AvatarUrl!=null){<img src="@u.AvatarUrl" referrerpolicy="no-referrer" alt=""/>}
            else{<i class="bi bi-person-circle" style="font-size:1rem;color:rgba(255,255,255,.4);"></i>}
            <span class="uname d-none d-sm-inline">@(u?.DisplayName?.Split(' ').FirstOrDefault())</span>
        </div>
        <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">@Html.AntiForgeryToken()<button class="logout-btn" title="Sign out"><i class="bi bi-box-arrow-right"></i></button></form>
    </div>
</nav>

<!-- ═══ MOBILE BOTTOM NAV ═══ -->
<nav class="bottom-nav">
    <div class="bnav-inner">
        <div class="bnav-item active" onclick="go('tp-ai',null,0);mNav(this)"><i class="bi bi-stars"></i>AI</div>
        <div class="bnav-item" onclick="go('tp-teams',null,1);mNav(this)"><i class="bi bi-diagram-3"></i>Teams</div>
        <div class="bnav-item" onclick="go('tp-kpi',null,2);mNav(this)"><i class="bi bi-graph-up-arrow"></i>KPIs</div>
        <div class="bnav-item" onclick="go('tp-log',null,3);mNav(this)"><i class="bi bi-journal-text"></i>Log</div>
        <div class="bnav-item" onclick="go('tp-fb',null,4);mNav(this)"><i class="bi bi-chat-dots"></i>Feedback</div>
        <div class="bnav-item" onclick="go('tp-inv',null,5);mNav(this)"><i class="bi bi-link-45deg"></i>Invite</div>
    </div>
</nav>

<div class="app-c">

@if(TempData["Message"]!=null){
<div class="toast-msg alert-dismissible fade show" role="alert">
    <i class="bi bi-check-circle-fill"></i> @TempData["Message"]
    <button type="button" class="btn-close" data-bs-dismiss="alert" style="font-size:.5rem;filter:brightness(0) invert(1);"></button>
</div>}

<!-- ═══ MONTH + ORG BAR ═══ -->
<div style="display:flex;align-items:center;gap:.55rem;margin-bottom:1.15rem;flex-wrap:wrap;">
    <form method="get" class="d-flex align-items:center;gap:.25rem;">
        <select name="month" class="form-select form-select-sm" style="width:115px;font-size:.76rem;" onchange="this.form.submit()">
            @for(int m=1;m<=12;m++){<option value="@m" selected="@(m==Model.SelectedMonth)">@(new DateTime(2026,m,1).ToString("MMMM"))</option>}
        </select>
        <input type="hidden" name="year" value="@Model.SelectedYear"/>
    </form>
    <span style="font-size:.66rem;color:var(--txt3);background:var(--pri3);padding:.18rem .55rem;border-radius:12px;font-weight:600;"><i class="bi bi-building"></i> @ViewBag.OrgName</span>
    @if(ai!=null&&ai.TeamHealthScore>0){<span style="font-size:.66rem;font-weight:700;padding:.18rem .5rem;border-radius:12px;background:@(ai.TeamHealthColor)15;color:@(ai.TeamHealthColor);"><i class="bi bi-heart-pulse"></i> @ai.TeamHealthScore/100</span>}
</div>

<!-- ═══ KPI CARDS ═══ -->
<div class="kpi-grid">
    <div class="kc"><div class="ki" style="background:var(--pri3);color:var(--pri);"><i class="bi bi-diagram-3-fill"></i></div><div class="kl">Teams</div><div class="kv">@Model.TotalTeams</div><div class="ks">@Model.TotalProjects projects</div></div>
    <div class="kc g"><div class="ki" style="background:var(--gbg);color:var(--g);"><i class="bi bi-people-fill"></i></div><div class="kl">People</div><div class="kv">@Model.TotalMembers</div><div class="ks">team members</div></div>
    <div class="kc"><div class="ki" style="background:var(--pri3);color:var(--pri);"><i class="bi bi-check2-all"></i></div><div class="kl">Done</div><div class="kv">@Model.TotalTasksCompleted<small style="font-size:.5rem;color:var(--txt4)">/@Model.TotalTasksAssigned</small></div><div class="ks">@Model.OverallCompletionPct%</div></div>
    <div class="kc r"><div class="ki" style="background:var(--rbg);color:var(--r);"><i class="bi bi-bug-fill"></i></div><div class="kl">Bugs</div><div class="kv">@Model.TotalBugsFound</div><div class="ks">@Model.TotalBugsFixed fixed</div></div>
    <div class="kc p"><div class="ki" style="background:var(--pbg);color:var(--p);"><i class="bi bi-award-fill"></i></div><div class="kl">Quality</div><div class="kv">@Model.AvgQuality<small style="font-size:.55rem;color:var(--txt4)">/5</small></div><div class="ks">avg rating</div></div>
    <div class="kc t"><div class="ki" style="background:var(--tbg);color:var(--t);"><i class="bi bi-clock-fill"></i></div><div class="kl">Hours</div><div class="kv">@Model.TotalHoursWorked.ToString("N0")</div><div class="ks">total</div></div>
    <div class="kc o"><div class="ki" style="background:var(--abg);color:var(--a);"><i class="bi bi-lightning-fill"></i></div><div class="kl">Overtime</div><div class="kv">@Model.TotalExtraHours.ToString("N0")</div><div class="ks">extra hrs</div></div>
    <div class="kc g"><div class="ki" style="background:var(--gbg);color:var(--g);"><i class="bi bi-bullseye"></i></div><div class="kl">Completion</div><div class="kv">@Model.OverallCompletionPct%</div><div style="height:4px;background:var(--brd);border-radius:2px;margin-top:.25rem;overflow:hidden;"><div style="height:100%;width:@(Model.OverallCompletionPct)%;background:var(--g);border-radius:2px;"></div></div></div>
</div>

<!-- ═══ DESKTOP TABS (hidden on mobile, mobile uses bottom nav) ═══ -->
<div class="tab-bar">
    <div class="tb active" onclick="go('tp-ai',this,0)"><i class="bi bi-stars"></i> AI Insights</div>
    <div class="tb" onclick="go('tp-teams',this,1)"><i class="bi bi-diagram-3"></i> Teams</div>
    <div class="tb" onclick="go('tp-kpi',this,2)"><i class="bi bi-graph-up-arrow"></i> KPIs</div>
    <div class="tb" onclick="go('tp-log',this,3)"><i class="bi bi-journal-text"></i> Daily Log</div>
    <div class="tb" onclick="go('tp-fb',this,4)"><i class="bi bi-chat-dots"></i> Feedback</div>
    <div class="tb" onclick="go('tp-inv',this,5)"><i class="bi bi-link-45deg"></i> Invite</div>
</div>

<!-- ══════════════════ TAB: AI INSIGHTS ══════════════════ -->
<div class="tp active" id="tp-ai">
@if(ai==null||ai.TeamHealthScore==0){
<div class="es"><i class="bi bi-stars"></i><p>Generate KPI records and fill in data to unlock AI-powered insights.</p></div>
} else {

<!-- Gemini AI Banner -->
<div style="background:linear-gradient(135deg,#4f46e5,#7c3aed);border-radius:var(--rd);padding:.6rem .85rem;margin-bottom:.7rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.4rem;">
    <div style="display:flex;align-items:center;gap:.4rem;color:#fff;">
        <i class="bi bi-stars" style="font-size:1.1rem;"></i>
        <div><div style="font-weight:700;font-size:.78rem;">Gemini AI Powered</div><div style="font-size:.6rem;opacity:.7;">Free tier — 250 requests/day</div></div>
    </div>
    <div style="display:flex;gap:.3rem;flex-wrap:wrap;">
        <button class="btn-a" style="background:rgba(255,255,255,.15);font-size:.65rem;padding:.25rem .55rem;" onclick="aiGenSummary()"><i class="bi bi-magic"></i> AI Summary</button>
        <button class="btn-a" style="background:rgba(255,255,255,.15);font-size:.65rem;padding:.25rem .55rem;" onclick="aiGenRecs()"><i class="bi bi-lightbulb"></i> AI Recommendations</button>
    </div>
</div>

<!-- AI Generated Content Area -->
<div id="ai-generated" style="display:none;background:linear-gradient(135deg,#0f172a,#1e293b);color:#fff;border-radius:var(--rd);padding:.9rem 1rem;margin-bottom:.85rem;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.4rem;">
        <div style="display:flex;align-items:center;gap:.4rem;"><i class="bi bi-stars" style="color:var(--pri2);font-size:1rem;"></i><span style="font-weight:700;font-size:.82rem;" id="ai-gen-title">AI Generated</span></div>
        <span style="font-size:.55rem;background:rgba(99,102,241,.3);padding:.12rem .4rem;border-radius:8px;color:var(--pri2);font-weight:600;">GEMINI AI</span>
    </div>
    <div id="ai-gen-content" style="font-size:.76rem;color:rgba(255,255,255,.75);line-height:1.55;"></div>
</div>

<!-- Rule-Based Executive Summary (always available) -->
<div style="background:linear-gradient(135deg,#0f172a,#1e293b);color:#fff;border-radius:var(--rd);padding:.9rem 1rem;margin-bottom:.85rem;">
    <div style="display:flex;align-items:center;gap:.4rem;margin-bottom:.4rem;">
        <i class="bi bi-cpu" style="color:var(--pri2);font-size:.9rem;"></i>
        <span style="font-weight:700;font-size:.82rem;">Smart Summary</span>
        <span style="font-size:.5rem;background:rgba(255,255,255,.1);padding:.1rem .3rem;border-radius:6px;color:rgba(255,255,255,.5);">LOCAL AI</span>
    </div>
    <p style="font-size:.76rem;color:rgba(255,255,255,.7);line-height:1.55;margin:0;">@ai.ExecutiveSummary</p>
</div>
<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div style="background:var(--card);border-radius:var(--rd);padding:1.1rem;text-align:center;box-shadow:var(--sh);height:100%;">
            <div class="kl" style="margin-bottom:.4rem;">Team Health</div>
            <div style="position:relative;width:90px;height:90px;margin:0 auto .4rem;">
                <svg viewBox="0 0 36 36" style="transform:rotate(-90deg);"><circle cx="18" cy="18" r="15.5" fill="none" stroke="#e2e8f0" stroke-width="3"/><circle cx="18" cy="18" r="15.5" fill="none" stroke="@ai.TeamHealthColor" stroke-width="3" stroke-dasharray="@(ai.TeamHealthScore*97.4/100) 97.4" stroke-linecap="round"/></svg>
                <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:1.4rem;font-weight:900;color:var(--txt);">@ai.TeamHealthScore</div>
            </div>
            <div style="font-weight:700;font-size:.82rem;color:@ai.TeamHealthColor;">@ai.TeamHealthLabel</div>
        </div>
    </div>
    <div class="col-md-8">
        <div style="background:var(--card);border-radius:var(--rd);padding:.75rem;box-shadow:var(--sh);height:100%;">
            <div style="font-weight:700;font-size:.8rem;margin-bottom:.4rem;"><i class="bi bi-bell"></i> Smart Alerts</div>
            @if(!ai.Alerts.Any()){<div style="font-size:.76rem;color:var(--txt4);padding:.5rem;">All clear — no alerts!</div>}
            @foreach(var al in ai.Alerts){
                var abg=al.Level switch{"critical"=>"var(--rbg)","warning"=>"var(--abg)","success"=>"var(--gbg)",_=>"var(--pri3)"};
                var acl=al.Level switch{"critical"=>"var(--r)","warning"=>"var(--a)","success"=>"var(--g)",_=>"var(--pri)"};
                <div style="background:@abg;border-radius:8px;padding:.45rem .6rem;margin-bottom:.35rem;display:flex;gap:.4rem;align-items:flex-start;">
                    <i class="bi @al.Icon" style="color:@acl;font-size:.8rem;margin-top:.1rem;flex-shrink:0;"></i>
                    <div><div style="font-weight:700;font-size:.7rem;color:@acl;">@al.Title</div><div style="font-size:.66rem;color:var(--txt2);line-height:1.4;">@al.Detail</div></div>
                </div>}
        </div>
    </div>
</div>
@if(ai.Recommendations.Any()){
<div style="background:var(--card);border-radius:var(--rd);padding:.75rem;box-shadow:var(--sh);margin-bottom:.85rem;">
    <div style="font-weight:700;font-size:.8rem;margin-bottom:.4rem;"><i class="bi bi-lightbulb" style="color:var(--a);"></i> AI Recommendations</div>
    <div class="row g-2">@foreach(var rc in ai.Recommendations){
        var rpbg=rc.Priority switch{"high"=>"var(--rbg)","medium"=>"var(--abg)",_=>"var(--bg2)"};
        var rpcl=rc.Priority switch{"high"=>"var(--r)","medium"=>"var(--a)",_=>"var(--txt3)"};
        <div class="col-12 col-md-6"><div style="background:var(--bg);border-radius:8px;padding:.5rem .6rem;border:1px solid var(--brd2);height:100%;">
            <div style="display:flex;align-items:center;gap:.3rem;margin-bottom:.2rem;"><i class="bi @rc.Icon" style="color:var(--pri);font-size:.75rem;"></i><span style="font-weight:700;font-size:.7rem;">@rc.Title</span><span style="font-size:.52rem;font-weight:700;padding:.08rem .3rem;border-radius:8px;background:@rpbg;color:@rpcl;margin-left:auto;">@rc.Priority</span></div>
            <div style="font-size:.66rem;color:var(--txt2);line-height:1.4;">@rc.Detail</div>
        </div></div>}</div>
</div>}
<div style="background:var(--card);border-radius:var(--rd);padding:.75rem;box-shadow:var(--sh);">
    <div style="font-weight:700;font-size:.8rem;margin-bottom:.4rem;"><i class="bi bi-person-check" style="color:var(--pri);"></i> AI Performance Insights</div>
    <div class="row g-2">@foreach(var mi in ai.MemberInsights){
        var rkbg=mi.RiskLevel switch{"high"=>"var(--rbg)","medium"=>"var(--abg)",_=>"var(--gbg)"};
        var rkcl=mi.RiskLevel switch{"high"=>"var(--r)","medium"=>"var(--a)",_=>"var(--g)"};
        <div class="col-12 col-md-6"><div style="border:1px solid var(--brd);border-radius:10px;padding:.6rem;height:100%;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.3rem;">
                <div><span style="font-size:.9rem;margin-right:.2rem;">@mi.Emoji</span><span style="font-weight:700;font-size:.8rem;">@mi.Name</span><span style="font-size:.58rem;color:var(--txt4);margin-left:.15rem;">@mi.Role</span></div>
                <span style="font-size:.52rem;font-weight:700;padding:.1rem .35rem;border-radius:8px;background:@rkbg;color:@rkcl;">@mi.RiskLevel</span>
            </div>
            <div style="font-size:.68rem;color:var(--txt2);line-height:1.4;margin-bottom:.3rem;">@mi.PerformanceSummary</div>
            @if(mi.Strengths.Any()){<div style="display:flex;flex-wrap:wrap;gap:.15rem;margin-bottom:.2rem;">@foreach(var s in mi.Strengths.Take(2)){<span style="font-size:.55rem;background:var(--gbg);color:var(--g);padding:.08rem .3rem;border-radius:6px;font-weight:600;">@s</span>}</div>}
            @if(mi.Improvements.Any()){<div style="display:flex;flex-wrap:wrap;gap:.15rem;">@foreach(var im in mi.Improvements.Take(2)){<span style="font-size:.55rem;background:var(--abg);color:var(--a);padding:.08rem .3rem;border-radius:6px;font-weight:600;">@im</span>}</div>}
            <details style="margin-top:.25rem;"><summary style="font-size:.6rem;color:var(--pri);cursor:pointer;font-weight:600;">AI feedback draft</summary><div style="font-size:.66rem;color:var(--txt2);background:var(--pri3);padding:.35rem .45rem;border-radius:6px;margin-top:.15rem;line-height:1.4;">@mi.FeedbackDraft</div></details>
        </div></div>}</div>
</div>}
</div>

<!-- ══════════════════ TAB: TEAMS ══════════════════ -->
<div class="tp" id="tp-teams">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.65rem;">
        <div style="font-weight:700;font-size:.88rem;">Teams & Members</div>
        @if(canEdit){<button class="btn-a" data-bs-toggle="modal" data-bs-target="#addTeamModal"><i class="bi bi-plus"></i> Team</button>}
    </div>
    @if(!Model.Teams.Any()){<div class="es"><i class="bi bi-diagram-3"></i><p>No teams yet. Create your first team!</p></div>}
    @foreach(var t in Model.Teams){var ci=Model.Teams.IndexOf(t)%tc.Length;
    <div class="tc">
        <div class="tc-h"><div style="display:flex;align-items:center;gap:.4rem;"><div style="width:6px;height:28px;border-radius:3px;background:@tc[ci];flex-shrink:0;"></div><div><span class="tn">@t.Name</span> <span class="pt" style="background:@tc[ci];">@t.Project</span></div></div>
        @if(canEdit){<a asp-controller="Teams" asp-action="Edit" asp-route-id="@t.Id" class="btn-g"><i class="bi bi-pencil"></i> Edit</a>}</div>
        <div class="tc-m"><i class="bi bi-star-fill" style="color:var(--a);font-size:.55rem;"></i> Lead: <strong>@t.TechLead</strong> <span style="margin-left:auto;">@t.Members.Count members</span></div>
        <div class="tc-b">
            @foreach(var m in t.Members.OrderBy(x=>x.Role.Contains("Lead")?0:1).ThenBy(x=>x.Name)){
                var dc=m.Role switch{var r when r.Contains("Lead")=>"#dc2626",var r when r.Contains("QA")=>"#059669",var r when r.Contains("Design")||r.Contains("UI")=>"#7c3aed",var r when r.Contains("Product")||r.Contains("BA")=>"#d97706",_=>"#2563eb"};
                <span class="mc"><span class="dot" style="background:@dc;"></span> @m.Name <span class="rl">@m.Role</span>@if(m.ProjectsAssigned.Contains(",")){<i class="bi bi-arrow-left-right" style="font-size:.5rem;color:var(--pri);" title="Multi-project"></i>}</span>}
            @if(canEdit){<button class="mc mc-a" data-bs-toggle="modal" data-bs-target="#addMemberModal" onclick="document.getElementById('nmt').value=@t.Id"><i class="bi bi-plus" style="font-size:.65rem;"></i> Add</button>}
        </div>
    </div>}
</div>

<!-- ══════════════════ TAB: KPI ══════════════════ -->
<div class="tp" id="tp-kpi">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.65rem;flex-wrap:wrap;gap:.4rem;">
        <div style="font-weight:700;font-size:.88rem;">KPI Scorecard</div>
        @if(canEdit){<a asp-controller="Kpi" asp-action="Generate" asp-route-month="@Model.SelectedMonth" asp-route-year="@Model.SelectedYear" class="btn-a"><i class="bi bi-plus"></i> Generate</a>}
    </div>
    @if(!Model.Kpis.Any()){<div class="es"><i class="bi bi-graph-up-arrow"></i><p>No KPI data. Click "Generate" to create records.</p></div>}
    else{<div class="tbl-w"><table class="tbl">
        <thead><tr><th style="text-align:left">Name</th><th>Team</th><th>Asgn</th><th>Done</th><th style="min-width:80px">%</th><th>Bugs</th><th>OT%</th><th>Qual</th><th>Hrs</th><th>Extra</th><th>Grade</th><th></th></tr></thead>
        <tbody>@foreach(var k in Model.Kpis){
            var pc=k.CompletionPct>=80?"g":k.CompletionPct>=50?"a":"r";
            var gc=k.Grade switch{"A"=>"gr-A","B"=>"gr-B","C"=>"gr-C","D"=>"gr-D","F"=>"gr-F",_=>"gr-n"};
            <tr>
                <td class="nc">@(k.Member.Role.Contains("Lead")?"<span style='color:var(--a);'>★</span> ":"")@k.Member.Name</td>
                <td style="font-size:.66rem;color:var(--txt3);">@k.Member.Team.Name</td>
                <td style="text-align:center">@k.TasksAssigned</td>
                <td style="text-align:center;font-weight:600;">@k.TasksCompleted</td>
                <td><div class="pb"><div class="pb-t"><div class="pb-f @pc" style="width:@(Math.Min(k.CompletionPct,100))%"></div></div><span class="pb-v" style="color:var(--@pc)">@k.CompletionPct%</span></div></td>
                <td style="text-align:center;@(k.BugsFoundInWork>3?"color:var(--r);font-weight:700;":"")">@k.BugsFoundInWork</td>
                <td style="text-align:center">@k.OnTimeDeliveryPct%</td>
                <td style="text-align:center">@for(int s=0;s<5;s++){<span style="color:@(s<k.QualityScore?"#d97706":"#e2e8f0");font-size:.55rem;">★</span>}</td>
                <td style="text-align:center">@k.TotalHoursWorked</td>
                <td style="text-align:center;@(k.ExtraHours>0?"color:var(--a);font-weight:600;":"color:var(--txt4);")">@k.ExtraHours</td>
                <td style="text-align:center"><span class="gr @gc">@k.Grade</span></td>
                <td>@if(canEdit){<a asp-controller="Kpi" asp-action="Edit" asp-route-id="@k.Id" class="btn-g" style="padding:.12rem .25rem;"><i class="bi bi-pencil"></i></a>}</td>
            </tr>}</tbody>
    </table></div>}
</div>

<!-- ══════════════════ TAB: DAILY LOG ══════════════════ -->
<div class="tp" id="tp-log">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.65rem;flex-wrap:wrap;gap:.4rem;">
        <div style="font-weight:700;font-size:.88rem;">Daily Work Log</div>
        @if(canEdit){<a asp-controller="DailyLog" asp-action="Create" class="btn-a"><i class="bi bi-plus"></i> Add Entry</a>}
    </div>
    @if(!Model.RecentLogs.Any()){<div class="es"><i class="bi bi-journal-text"></i><p>No entries. <a asp-controller="DailyLog" asp-action="Create">Add one</a>.</p></div>}
    else{<div class="tbl-w"><table class="tbl">
        <thead><tr><th style="text-align:left">Date</th><th style="text-align:left">Name</th><th>Project</th><th style="text-align:left">Task</th><th>Status</th><th>Hrs</th><th></th></tr></thead>
        <tbody>@foreach(var l in Model.RecentLogs){
            var sc=l.Status switch{"Completed"=>"sp-c","In Progress"=>"sp-p","Blocked"=>"sp-b","In Review"=>"sp-r","Carry Forward"=>"sp-f",_=>"sp-d"};
            <tr>
                <td style="white-space:nowrap;font-size:.7rem;color:var(--txt3);">@l.Date.ToString("dd MMM")</td>
                <td class="nc">@l.Member.Name</td>
                <td style="text-align:center;font-size:.66rem;">@l.Project</td>
                <td style="max-width:200px;font-size:.7rem;color:var(--txt2);">@(l.TaskDescription.Length>45?l.TaskDescription[..45]+"…":l.TaskDescription)</td>
                <td style="text-align:center"><span class="sp @sc">@l.Status</span></td>
                <td style="text-align:center;font-weight:600;">@l.HoursWorked</td>
                <td>@if(canEdit){<a asp-controller="DailyLog" asp-action="Edit" asp-route-id="@l.Id" class="btn-g" style="padding:.12rem .25rem;"><i class="bi bi-pencil"></i></a>}</td>
            </tr>}</tbody>
    </table></div>}
</div>

<!-- ══════════════════ TAB: FEEDBACK ══════════════════ -->
<div class="tp" id="tp-fb">
    <div style="font-weight:700;font-size:.88rem;margin-bottom:.65rem;">Feedback & Achievements</div>
    @if(!Model.Kpis.Any()){<div class="es"><i class="bi bi-chat-dots"></i><p>Generate KPIs first.</p></div>}
    <div class="row g-2">@foreach(var k in Model.Kpis){var ci2=Model.Kpis.IndexOf(k)%tc.Length;
    <div class="col-12 col-sm-6 col-lg-4"><div class="fc">
        <div class="fc-h"><span style="font-weight:700;font-size:.8rem;">@(k.Member.Role.Contains("Lead")?"★ ":"")@k.Member.Name</span><span style="font-size:.52rem;font-weight:700;padding:.1rem .35rem;border-radius:6px;background:@(tc[ci2])15;color:@tc[ci2];">@k.Member.Team.Name</span></div>
        <div class="fc-b">
            <div class="fs"><div class="fl" style="color:var(--pri);"><i class="bi bi-trophy"></i> Achievements</div><div class="ft @(string.IsNullOrEmpty(k.Achievements)?"em":"")" style="background:var(--pri3);">@(string.IsNullOrEmpty(k.Achievements)?"Not recorded":k.Achievements)</div></div>
            <div class="fs"><div class="fl" style="color:var(--r);"><i class="bi bi-bug"></i> Errors</div><div class="ft @(string.IsNullOrEmpty(k.ErrorsLog)?"em":"")" style="background:var(--rbg);">@(string.IsNullOrEmpty(k.ErrorsLog)?"None":k.ErrorsLog)</div></div>
            <div class="fs"><div class="fl" style="color:var(--a);"><i class="bi bi-chat-left-quote"></i> TL Feedback</div><div class="ft @(string.IsNullOrEmpty(k.TechLeadFeedback)?"em":"")" style="background:var(--abg);">@(string.IsNullOrEmpty(k.TechLeadFeedback)?"Pending":k.TechLeadFeedback)</div></div>
            <div class="fs"><div class="fl" style="color:var(--g);"><i class="bi bi-person-check"></i> Manager</div><div class="ft @(string.IsNullOrEmpty(k.ManagerFeedback)?"em":"")" style="background:var(--gbg);">@(string.IsNullOrEmpty(k.ManagerFeedback)?"Pending":k.ManagerFeedback)</div></div>
        </div>
        @if(canEdit){<div style="padding:.35rem .55rem;border-top:1px solid var(--brd2);"><a asp-controller="Kpi" asp-action="Edit" asp-route-id="@k.Id" class="btn-g" style="width:100%;justify-content:center;"><i class="bi bi-pencil"></i> Edit</a></div>}
    </div></div>}</div>
</div>

<!-- ══════════════════ TAB: INVITE ══════════════════ -->
<div class="tp" id="tp-inv">
    <div style="font-weight:700;font-size:.88rem;margin-bottom:.65rem;">Invite & Share</div>
    @if(canEdit){
    <div style="background:var(--pri3);border:1px solid #c7d2fe;border-radius:var(--rd);padding:.65rem;margin-bottom:.85rem;">
        <div style="font-weight:700;font-size:.76rem;color:var(--pri);margin-bottom:.4rem;"><i class="bi bi-link-45deg"></i> Create Invite Link</div>
        <form asp-controller="Invite" asp-action="Create" method="post" style="display:flex;gap:.4rem;align-items:end;flex-wrap:wrap;">
            @Html.AntiForgeryToken()
            <div><label class="form-label">Role</label><select name="role" class="form-select form-select-sm" style="width:105px;"><option value="Viewer">Viewer</option><option value="Manager">Manager</option></select></div>
            <div><label class="form-label">Max Uses</label><input type="number" name="maxUses" value="0" min="0" class="form-control form-control-sm" style="width:55px;"/></div>
            <div><label class="form-label">Expires</label><input type="number" name="expiryDays" placeholder="∞ days" min="1" class="form-control form-control-sm" style="width:65px;"/></div>
            <button class="btn-a"><i class="bi bi-link-45deg"></i> Generate</button>
        </form>
    </div>}
    @foreach(var lk in inviteLinks.Where(l=>l.IsValid)){var url=$"{Context.Request.Scheme}://{Context.Request.Host}/Auth/Join/{lk.Code}";
    <div class="ic">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.35rem;">
            <div><span style="font-size:.58rem;font-weight:700;padding:.1rem .35rem;border-radius:6px;color:#fff;background:@(lk.Role=="Manager"?"var(--pri)":"var(--txt3)");">@lk.Role</span><span style="font-size:.58rem;color:var(--txt4);margin-left:.25rem;">@lk.TimesUsed@(lk.MaxUses>0?$"/{lk.MaxUses}":"") uses</span></div>
            @if(canEdit){<form asp-controller="Invite" asp-action="Deactivate" asp-route-id="@lk.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button class="btn-g" style="color:var(--r);border-color:var(--r);padding:.1rem .22rem;font-size:.55rem;"><i class="bi bi-x-lg"></i></button></form>}
        </div>
        <div class="input-group input-group-sm"><input type="text" class="form-control" value="@url" readonly id="lnk-@lk.Id" style="font-size:.68rem;"/><button class="btn btn-outline-primary" style="font-size:.62rem;" onclick="navigator.clipboard.writeText(document.getElementById('lnk-@lk.Id').value);this.innerHTML='<i class=\'bi bi-check-lg\'></i> Copied!';setTimeout(()=>this.innerHTML='<i class=\'bi bi-clipboard\'></i> Copy',2000)"><i class="bi bi-clipboard"></i> Copy</button></div>
    </div>}
    @if(orgMembers.Any()){
    <div style="font-weight:700;font-size:.8rem;margin:.85rem 0 .4rem;"><i class="bi bi-people"></i> Members (@orgMembers.Count)</div>
    <div class="tbl-w"><table class="tbl">
        <thead><tr><th style="text-align:left">Member</th><th>Email</th><th>Role</th></tr></thead>
        <tbody>@foreach(var m in orgMembers){
            var rbg=m.OrgRole switch{"Owner"=>"var(--rbg)","Manager"=>"var(--pri3)",_=>"var(--bg2)"};
            var rcl=m.OrgRole switch{"Owner"=>"var(--r)","Manager"=>"var(--pri)",_=>"var(--txt3)"};
            <tr>
                <td style="text-align:left"><div style="display:flex;align-items:center;gap:.35rem;">
                    @if(m.AvatarUrl!=null){<img src="@m.AvatarUrl" style="width:20px;height:20px;border-radius:50%;border:1.5px solid var(--brd);" referrerpolicy="no-referrer"/>}
                    else{<div style="width:20px;height:20px;border-radius:50%;background:var(--pri3);display:flex;align-items:center;justify-content:center;font-size:.52rem;font-weight:700;color:var(--pri);">@(m.DisplayName?.FirstOrDefault())</div>}
                    <span style="font-weight:600;font-size:.76rem;">@m.DisplayName</span></div></td>
                <td style="font-size:.66rem;color:var(--txt4);">@m.Email</td>
                <td style="text-align:center"><span style="font-size:.58rem;font-weight:700;padding:.1rem .35rem;border-radius:6px;background:@rbg;color:@rcl;">@m.OrgRole</span></td>
            </tr>}</tbody>
    </table></div>}
</div>

