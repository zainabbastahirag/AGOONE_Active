@model TeamTracker.ViewModels.DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }

<div class="top-header">
    <h3><i class="bi bi-speedometer2"></i> Dashboard</h3>
    <form class="d-flex gap-2" method="get">
        <select name="month" class="form-select form-select-sm" style="width:130px;">
            @for (int m = 1; m <= 12; m++)
            {
                <option value="@m" selected="@(m == Model.SelectedMonth)">@(new DateTime(2026, m, 1).ToString("MMMM"))</option>
            }
        </select>
        <input type="number" name="year" class="form-control form-control-sm" value="@Model.SelectedYear" style="width:80px;" />
        <button class="btn btn-primary btn-sm">Go</button>
    </form>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3"><div class="card kpi-card p-3" style="border-left-color:#3182ce;">
        <div class="kpi-label">Teams</div><div class="kpi-val">@Model.TotalTeams</div>
        <small class="text-muted">@Model.TotalMembers people</small>
    </div></div>
    <div class="col-6 col-md-3"><div class="card kpi-card p-3" style="border-left-color:#38a169;">
        <div class="kpi-label">Tasks Completed</div><div class="kpi-val">@Model.TotalTasksCompleted</div>
        <small class="text-muted">of @Model.TotalTasksAssigned assigned (@Model.OverallCompletionPct%)</small>
    </div></div>
    <div class="col-6 col-md-3"><div class="card kpi-card p-3" style="border-left-color:#e53e3e;">
        <div class="kpi-label">Bugs Found</div><div class="kpi-val">@Model.TotalBugsFound</div>
        <small class="text-muted">@Model.TotalBugsFixed fixed</small>
    </div></div>
    <div class="col-6 col-md-3"><div class="card kpi-card p-3" style="border-left-color:#805ad5;">
        <div class="kpi-label">Avg Quality</div><div class="kpi-val">@Model.AvgQuality / 5</div>
        <small class="text-muted">team average</small>
    </div></div>
    <div class="col-6 col-md-3"><div class="card kpi-card p-3" style="border-left-color:#319795;">
        <div class="kpi-label">Total Hours</div><div class="kpi-val">@Model.TotalHoursWorked.ToString("N0")</div>
        <small class="text-muted">man-hours</small>
    </div></div>
    <div class="col-6 col-md-3"><div class="card kpi-card p-3" style="border-left-color:#dd6b20;">
        <div class="kpi-label">Extra Hours</div><div class="kpi-val">@Model.TotalExtraHours.ToString("N0")</div>
        <small class="text-muted">overtime</small>
    </div></div>
    <div class="col-6 col-md-3"><div class="card kpi-card p-3" style="border-left-color:#d69e2e;">
        <div class="kpi-label">Projects</div><div class="kpi-val">@Model.TotalProjects</div>
        <small class="text-muted">active</small>
    </div></div>
    <div class="col-6 col-md-3"><div class="card kpi-card p-3" style="border-left-color:#38a169;">
        <div class="kpi-label">Completion</div><div class="kpi-val">@Model.OverallCompletionPct%</div>
        <div class="progress mt-1" style="height:6px;">
            <div class="progress-bar bg-success" style="width:@(Model.OverallCompletionPct)%"></div>
        </div>
    </div></div>
</div>

<div class="row g-3">
    <!-- KPI Scorecard -->
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span><i class="bi bi-graph-up-arrow"></i> KPI Scorecard — @(new DateTime(Model.SelectedYear, Model.SelectedMonth, 1).ToString("MMMM yyyy"))</span>
                <a asp-controller="Kpi" asp-action="Generate" asp-route-month="@Model.SelectedMonth" asp-route-year="@Model.SelectedYear" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-plus-circle"></i> Generate KPI Records
                </a>
            </div>
            <div class="card-body p-0 table-responsive">
                @if (Model.Kpis.Any())
                {
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Name</th><th>Team</th><th>Assigned</th><th>Completed</th><th>Completion</th>
                                <th>Bugs</th><th>On-Time</th><th>Quality</th><th>Hours</th><th>Grade</th><th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var k in Model.Kpis)
                            {
                                var gradeCls = k.Grade switch { "A" or "B" => "grade-a", "C" => "grade-c", _ => "grade-d" };
                                <tr>
                                    <td class="fw-semibold">@(k.Member.Role.Contains("Lead") ? "★ " : "")@k.Member.Name</td>
                                    <td>@k.Member.Team.Name</td>
                                    <td class="text-center">@k.TasksAssigned</td>
                                    <td class="text-center">@k.TasksCompleted</td>
                                    <td class="text-center">
                                        <div class="progress" style="height:18px;min-width:60px;">
                                            <div class="progress-bar @(k.CompletionPct >= 80 ? "bg-success" : k.CompletionPct >= 50 ? "bg-warning" : "bg-danger")"
                                                 style="width:@(k.CompletionPct)%">@(k.CompletionPct)%</div>
                                        </div>
                                    </td>
                                    <td class="text-center">@k.BugsFoundInWork</td>
                                    <td class="text-center">@k.OnTimeDeliveryPct%</td>
                                    <td class="text-center">@k.QualityScore/5</td>
                                    <td class="text-center">@k.TotalHoursWorked</td>
                                    <td class="text-center @gradeCls" style="font-size:1.1rem;">@k.Grade</td>
                                    <td><a asp-controller="Kpi" asp-action="Edit" asp-route-id="@k.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-inbox" style="font-size:2rem;"></i>
                        <p class="mt-2">No KPI data yet for this month. Click "Generate KPI Records" to create entries for all members.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Recent Daily Logs -->
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span><i class="bi bi-journal-text"></i> Recent Daily Logs</span>
                <a asp-controller="DailyLog" asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus"></i> Add Entry</a>
            </div>
            <div class="card-body p-0 table-responsive">
                @if (Model.RecentLogs.Any())
                {
                    <table class="table table-hover mb-0">
                        <thead><tr><th>Date</th><th>Name</th><th>Team</th><th>Project</th><th>Task</th><th>Status</th><th>Hours</th></tr></thead>
                        <tbody>
                            @foreach (var l in Model.RecentLogs.Take(20))
                            {
                                var bgCls = l.Status switch { "Completed" => "table-success", "Blocked" => "table-danger", "In Progress" => "table-info", "Carry Forward" => "table-warning", _ => "" };
                                <tr class="@bgCls">
                                    <td>@l.Date.ToString("dd-MMM")</td>
                                    <td class="fw-semibold">@l.Member.Name</td>
                                    <td>@l.Member.Team.Name</td>
                                    <td>@l.Project</td>
                                    <td>@(l.TaskDescription.Length > 50 ? l.TaskDescription[..50] + "..." : l.TaskDescription)</td>
                                    <td><span class="badge badge-status @(l.Status switch { "Completed" => "bg-success", "Blocked" => "bg-danger", "In Progress" => "bg-primary", "Carry Forward" => "bg-warning text-dark", _ => "bg-secondary" })">@l.Status</span></td>
                                    <td>@l.HoursWorked</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <p>No daily logs yet. <a asp-controller="DailyLog" asp-action="Create">Add the first entry</a>.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Teams Overview -->
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-white"><i class="bi bi-people"></i> Teams Overview</div>
            <div class="card-body p-0 table-responsive">
                <table class="table table-hover mb-0">
                    <thead><tr><th>Team</th><th>Project</th><th>Tech Lead</th><th>Members</th></tr></thead>
                    <tbody>
                        @foreach (var t in Model.Teams)
                        {
                            <tr>
                                <td class="fw-semibold">@t.Name</td>
                                <td><span class="badge bg-primary">@t.Project</span></td>
                                <td>★ @t.TechLead</td>
                                <td>@string.Join(", ", t.Members.Select(m => m.Name))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
