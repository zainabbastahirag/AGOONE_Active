@section Scripts{
<script>
function go(id,el,idx){
    document.querySelectorAll('.tp').forEach(p=>p.classList.remove('active'));
    document.getElementById(id).classList.add('active');
    // Desktop tabs
    document.querySelectorAll('.tb').forEach(t=>t.classList.remove('active'));
    if(el&&el.classList.contains('tb'))el.classList.add('active');
    else document.querySelectorAll('.tb')[idx]?.classList.add('active');
    // Desktop nav links
    document.querySelectorAll('.nav-links a').forEach(a=>a.classList.remove('active'));
    document.querySelectorAll('.nav-links a')[idx]?.classList.add('active');
    // Mobile bottom nav
    mNav(document.querySelectorAll('.bnav-item')[idx]);
    // Scroll to top of content
    window.scrollTo({top:0,behavior:'smooth'});
}
function mNav(el){
    if(!el)return;
    document.querySelectorAll('.bnav-item').forEach(b=>b.classList.remove('active'));
    el.classList.add('active');
}

// ── Gemini AI Functions ──
async function aiCall(url, body, titleText) {
    const box = document.getElementById('ai-generated');
    const title = document.getElementById('ai-gen-title');
    const content = document.getElementById('ai-gen-content');
    box.style.display = 'block';
    title.textContent = titleText;
    content.innerHTML = '<div style="display:flex;align-items:center;gap:.4rem;"><div class="spinner-border spinner-border-sm" style="width:14px;height:14px;border-width:2px;color:var(--pri2);"></div> Generating with Gemini AI...</div>';
    box.scrollIntoView({ behavior: 'smooth', block: 'start' });
    try {
        const res = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        });
        const data = await res.json();
        if (data.text && data.text.length > 10) {
            content.innerHTML = data.text.replace(/\n/g, '<br/>');
        } else if (!data.ai) {
            content.innerHTML = '<span style="color:var(--pri2);">Add your free Gemini API key in appsettings.json to enable AI.<br/>Get one free at <a href="https://aistudio.google.com/app/apikey" target="_blank" style="color:#818cf8;">aistudio.google.com</a> (no credit card needed).</span>';
        } else {
            content.textContent = 'No data available to generate insights.';
        }
    } catch (e) {
        content.textContent = 'Error connecting to AI service.';
    }
}

function aiGenSummary() {
    aiCall('/api/ai/summary', { month: @Model.SelectedMonth, year: @Model.SelectedYear }, 'AI Executive Summary');
}
function aiGenRecs() {
    aiCall('/api/ai/recommendations', { month: @Model.SelectedMonth, year: @Model.SelectedYear }, 'AI Recommendations');
}
</script>}
