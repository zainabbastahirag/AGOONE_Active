<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — KpiPulse</title>
    <meta name="description" content="KpiPulse — Free lightweight project & people management tool. Track teams, KPIs, daily work, and export to Excel." />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root { --sidebar-w: 230px; --primary: #0f172a; --accent: #6366f1; --accent-l: #818cf8; }
        body { font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; background: #f1f5f9; }
        .sidebar {
            position: fixed; top: 0; left: 0; width: var(--sidebar-w); height: 100vh;
            background: var(--primary); color: #fff; z-index: 1000; overflow-y: auto;
            display: flex; flex-direction: column;
        }
        .sidebar .brand { padding: 1.1rem 1rem; border-bottom: 1px solid rgba(255,255,255,.08); }
        .sidebar .brand h5 { font-weight: 800; margin: 0; font-size: 1.15rem; letter-spacing: -.02em; }
        .sidebar .brand h5 span { color: var(--accent-l); }
        .sidebar .brand small { opacity: .5; font-size: .68rem; display: block; margin-top: .1rem; }
        .sidebar .nav-link {
            color: rgba(255,255,255,.6); padding: .55rem 1rem; font-size: .82rem;
            border-left: 3px solid transparent; transition: all .15s;
        }
        .sidebar .nav-link:hover { color: #fff; background: rgba(255,255,255,.06); }
        .sidebar .nav-link.active { color: #fff; background: rgba(99,102,241,.15); border-left-color: var(--accent); font-weight: 600; }
        .sidebar .nav-link i { width: 22px; text-align: center; margin-right: .45rem; }
        .sidebar .section-label { font-size: .6rem; text-transform: uppercase; letter-spacing: .1em; color: rgba(255,255,255,.3); padding: .7rem 1rem .2rem; }
        .sidebar .user-block { margin-top: auto; padding: .75rem 1rem; border-top: 1px solid rgba(255,255,255,.08); display: flex; align-items: center; gap: .5rem; }
        .sidebar .user-block img { width: 28px; height: 28px; border-radius: 50%; }
        .sidebar .user-block .uname { font-size: .78rem; color: rgba(255,255,255,.7); }
        .sidebar .user-block .urole { font-size: .6rem; color: var(--accent-l); text-transform: uppercase; letter-spacing: .05em; }
        .main-content { margin-left: var(--sidebar-w); padding: 1.25rem 1.5rem; min-height: 100vh; }
        .top-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.1rem; flex-wrap: wrap; gap: .5rem; }
        .top-header h3 { font-weight: 700; color: var(--primary); margin: 0; font-size: 1.2rem; }
        .card { border: none; box-shadow: 0 1px 3px rgba(0,0,0,.05); border-radius: 10px; }
        .card-header { font-weight: 600; font-size: .88rem; }
        .kpi-card { border-left: 4px solid var(--accent); }
        .kpi-card .kpi-val { font-size: 1.65rem; font-weight: 800; color: var(--primary); }
        .kpi-card .kpi-label { font-size: .65rem; text-transform: uppercase; letter-spacing: .07em; color: #64748b; }
        .table { font-size: .82rem; }
        .table thead th { background: var(--primary); color: #fff; font-size: .72rem; text-transform: uppercase; letter-spacing: .04em; border: none; white-space: nowrap; }
        .grade-a, .grade-b { color: #16a34a; font-weight: 700; }
        .grade-c { color: #ca8a04; font-weight: 700; }
        .grade-d, .grade-f { color: #dc2626; font-weight: 700; }
        .btn-primary { background: var(--accent); border-color: var(--accent); }
        .btn-primary:hover { background: #4f46e5; border-color: #4f46e5; }
        .btn-outline-primary { color: var(--accent); border-color: var(--accent); }
        .btn-outline-primary:hover { background: var(--accent); border-color: var(--accent); }
        @@media (max-width: 768px) {
            .sidebar { width: 100%; height: auto; position: relative; flex-direction: row; flex-wrap: wrap; }
            .sidebar .brand { width: 100%; }
            .sidebar .user-block { margin-top: 0; }
            .main-content { margin-left: 0; }
        }
    </style>
</head>
<body>

@if (User.Identity != null && User.Identity.IsAuthenticated)
{
<nav class="sidebar">
    <div class="brand">
        <h5>Kpi<span>Pulse</span></h5>
        <small>Project & People Management</small>
    </div>
    <div class="section-label">Overview</div>
    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" href="/">
        <i class="bi bi-grid-1x2-fill"></i> Dashboard
    </a>
    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "DailyLog" ? "active" : "")" asp-controller="DailyLog" asp-action="Index">
        <i class="bi bi-journal-text"></i> Daily Log
    </a>
    <div class="section-label">Manage</div>
    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Teams" ? "active" : "")" asp-controller="Teams" asp-action="Index">
        <i class="bi bi-diagram-3-fill"></i> Teams
    </a>
    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Members" ? "active" : "")" asp-controller="Members" asp-action="Index">
        <i class="bi bi-people-fill"></i> Members
    </a>
    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Kpi" ? "active" : "")" asp-controller="Kpi" asp-action="Index">
        <i class="bi bi-graph-up-arrow"></i> Monthly KPI
    </a>
    <div class="section-label">Reports</div>
    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Export" ? "active" : "")" asp-controller="Export" asp-action="Index">
        <i class="bi bi-file-earmark-excel-fill"></i> Export Excel
    </a>
    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Invite" ? "active" : "")" asp-controller="Invite" asp-action="Index">
        <i class="bi bi-link-45deg"></i> Invite & Share
    </a>
    <div class="user-block">
        @if (ViewBag.AvatarUrl != null)
        {
            <img src="@ViewBag.AvatarUrl" alt="" referrerpolicy="no-referrer" />
        }
        else
        {
            <i class="bi bi-person-circle" style="font-size:1.4rem;opacity:.6;"></i>
        }
        <div>
            <div class="uname">@(ViewBag.UserName ?? User.Identity?.Name ?? "User")</div>
            <div class="urole">@(ViewBag.OrgRole ?? "")</div>
        </div>
        <form asp-controller="Auth" asp-action="Logout" method="post" class="ms-auto">
            @Html.AntiForgeryToken()
            <button class="btn btn-sm btn-link text-white-50 p-0" title="Logout"><i class="bi bi-box-arrow-right"></i></button>
        </form>
    </div>
</nav>
}

<div class="@(User.Identity != null && User.Identity.IsAuthenticated ? "main-content" : "")">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @RenderBody()
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
