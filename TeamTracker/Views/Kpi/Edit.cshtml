@model TeamTracker.Models.MonthlyKpi
@{ ViewData["Title"] = $"Edit KPI — {Model.Member?.Name}"; }

<div class="top-header">
    <h3><i class="bi bi-pencil"></i> Edit KPI — @Model.Member?.Name</h3>
    <a asp-action="Index" asp-route-month="@Model.Month" asp-route-year="@Model.Year" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white">
                <strong>@Model.Member?.Name</strong> — @Model.Member?.Team?.Name — @Model.Member?.Team?.Project
                <span class="badge bg-secondary ms-2">@Model.MonthName @Model.Year</span>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="MemberId" />
                    <input type="hidden" asp-for="Year" />
                    <input type="hidden" asp-for="Month" />

                    <h6 class="text-primary fw-bold mb-3"><i class="bi bi-bar-chart"></i> Performance KPIs</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label class="form-label">Tasks Assigned</label>
                            <input type="number" asp-for="TasksAssigned" class="form-control" min="0" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Tasks Completed</label>
                            <input type="number" asp-for="TasksCompleted" class="form-control" min="0" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">On-Time Delivery %</label>
                            <input type="number" asp-for="OnTimeDeliveryPct" class="form-control" min="0" max="100" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Bugs Found in Work</label>
                            <input type="number" asp-for="BugsFoundInWork" class="form-control" min="0" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Bugs Fixed</label>
                            <input type="number" asp-for="BugsFixed" class="form-control" min="0" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Code Reviews Done</label>
                            <input type="number" asp-for="CodeReviewsDone" class="form-control" min="0" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Quality Score (1-5)</label>
                            <select asp-for="QualityScore" class="form-select">
                                <option value="0">Not Rated</option>
                                <option value="1">1 — Poor</option>
                                <option value="2">2 — Below Average</option>
                                <option value="3">3 — Average</option>
                                <option value="4">4 — Good</option>
                                <option value="5">5 — Excellent</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Total Hours Worked</label>
                            <input type="number" asp-for="TotalHoursWorked" class="form-control" step="0.5" min="0" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Extra / Overtime Hours</label>
                            <input type="number" asp-for="ExtraHours" class="form-control" step="0.5" min="0" />
                        </div>
                    </div>

                    <h6 class="text-primary fw-bold mb-3"><i class="bi bi-chat-dots"></i> Feedback & Notes</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-12">
                            <label class="form-label">Achievements</label>
                            <textarea asp-for="Achievements" class="form-control" rows="2" placeholder="Notable accomplishments this month"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Errors / Issues Log</label>
                            <textarea asp-for="ErrorsLog" class="form-control" rows="2" placeholder="Specific errors or issues"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Tech Lead Feedback</label>
                            <textarea asp-for="TechLeadFeedback" class="form-control" rows="2" placeholder="Feedback from Tech Lead"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Manager Feedback</label>
                            <textarea asp-for="ManagerFeedback" class="form-control" rows="2" placeholder="Your feedback as manager"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Progress Notes</label>
                            <textarea asp-for="ProgressNotes" class="form-control" rows="2" placeholder="General progress notes"></textarea>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save KPI</button>
                    <a asp-action="Index" asp-route-month="@Model.Month" asp-route-year="@Model.Year" class="btn btn-light ms-2">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
