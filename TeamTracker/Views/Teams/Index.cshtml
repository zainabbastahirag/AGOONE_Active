@model List<TeamTracker.Models.Team>
@{ ViewData["Title"] = "Teams"; }

<div class="top-header">
    <h3><i class="bi bi-diagram-3-fill"></i> Teams</h3>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Add Team</a>
</div>

<div class="row g-3">
    @foreach (var team in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <span class="fw-bold">@team.Name</span>
                    <span class="badge bg-primary">@team.Project</span>
                </div>
                <div class="card-body">
                    <div class="mb-2">
                        <small class="text-muted">Tech Lead</small><br/>
                        <span class="fw-semibold">★ @team.TechLead</span>
                    </div>
                    <div class="mb-2">
                        <small class="text-muted">Members (@team.Members.Count)</small><br/>
                        @foreach (var m in team.Members.OrderBy(x => x.Name))
                        {
                            <span class="badge bg-light text-dark border me-1 mb-1">@m.Name <small class="text-muted">@m.Role</small></span>
                        }
                    </div>
                </div>
                <div class="card-footer bg-white border-0 d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@team.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i> Edit</a>
                    <form asp-action="Delete" asp-route-id="@team.Id" method="post" onsubmit="return confirm('Delete team @team.Name?');">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Delete</button>
                    </form>
                </div>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5 text-muted">
            <i class="bi bi-diagram-3" style="font-size:2.5rem;"></i>
            <p class="mt-2">No teams yet. <a asp-action="Create">Create your first team</a>.</p>
        </div>
    }
</div>
