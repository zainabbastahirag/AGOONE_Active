@model TeamTracker.Models.Team
@{ ViewData["Title"] = $"Edit — {Model.Name}"; }

<nav class="topnav">
    <a href="/" class="brand" style="text-decoration:none;">Kpi<span>Pulse</span></a>
    <a href="/" class="btn-export"><i class="bi bi-arrow-left"></i> Back</a>
</nav>

<div class="app-container" style="max-width:500px;margin-top:1.5rem;">
    <div style="background:var(--card);border-radius:var(--r);box-shadow:var(--sh-md);overflow:hidden;">
        <div style="background:linear-gradient(135deg,#0f172a,#1e293b);color:#fff;padding:1rem 1.15rem;">
            <h5 style="font-weight:700;font-size:1rem;margin:0;"><i class="bi bi-pencil"></i> Edit Team — @Model.Name</h5>
        </div>
        <div style="padding:1.15rem;">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@Model.Id" />
                <div class="mb-3">
                    <label style="font-size:.75rem;font-weight:600;color:var(--txt-3);display:block;margin-bottom:.25rem;">Team Name</label>
                    <input name="Name" value="@Model.Name" class="form-control" required style="border-radius:10px;"/>
                </div>
                <div class="mb-3">
                    <label style="font-size:.75rem;font-weight:600;color:var(--txt-3);display:block;margin-bottom:.25rem;">Project</label>
                    <input name="Project" value="@Model.Project" class="form-control" required style="border-radius:10px;"/>
                </div>
                <div class="mb-4">
                    <label style="font-size:.75rem;font-weight:600;color:var(--txt-3);display:block;margin-bottom:.25rem;">Tech Lead</label>
                    <input name="TechLead" value="@Model.TechLead" class="form-control" required style="border-radius:10px;"/>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn-accent" style="flex:1;justify-content:center;padding:.55rem;"><i class="bi bi-check-lg"></i> Save Changes</button>
                    <a href="/" class="btn-ghost" style="padding:.55rem .75rem;">Cancel</a>
                </div>
            </form>
        </div>
    </div>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-3" onsubmit="return confirm('Delete team @Model.Name and all its members?');">
        @Html.AntiForgeryToken()
        <button style="width:100%;background:var(--red-bg);border:1px solid #fecaca;color:var(--red);padding:.5rem;border-radius:10px;font-weight:600;font-size:.78rem;cursor:pointer;">
            <i class="bi bi-trash"></i> Delete This Team
        </button>
    </form>
</div>
