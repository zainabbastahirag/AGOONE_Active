@model TeamTracker.Models.Team
@{ ViewData["Title"] = "Add Team"; }

<div class="top-header">
    <h3><i class="bi bi-plus-circle"></i> Add Team</h3>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="card" style="max-width:600px;">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">Team Name</label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Team 1, Backend Squad" />
            </div>
            <div class="mb-3">
                <label class="form-label">Project</label>
                <input asp-for="Project" class="form-control" placeholder="e.g. AGONEWorkj" />
            </div>
            <div class="mb-3">
                <label class="form-label">Tech Lead</label>
                <input asp-for="TechLead" class="form-control" placeholder="e.g. Abdullah" />
            </div>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Create Team</button>
        </form>
    </div>
</div>
