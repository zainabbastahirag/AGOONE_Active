@using AgOne.Shared.Auth.Configuration
@using AgOne.Shared.Auth.Services
@using Microsoft.Extensions.Options

@inject IAgOneSsoService SsoService
@inject IOptions<AgOneSsoSettings> Settings

@* 
    AG ONE Product Navigator Component
    Displays navigation links to all AG ONE products.
    Can be embedded in a navbar or sidebar.
    
    Usage:
    <AgOneProductNavigator />
    
    Or with custom styling:
    <AgOneProductNavigator CssClass="my-product-nav" />
*@

<nav class="@($"agone-product-nav {CssClass}")">
    @foreach (var product in GetAvailableProducts())
    {
        <a class="agone-product-link @(IsCurrentProduct(product.Name) ? "active" : "")"
           @onclick="() => NavigateToProduct(product.Name)"
           @onclick:preventDefault
           href="@product.Url">
            @product.Name
        </a>
    }
</nav>

@code {
    [Parameter] public string CssClass { get; set; } = "";

    private record ProductInfo(string Name, string Url);

    private IEnumerable<ProductInfo> GetAvailableProducts()
    {
        var products = new List<ProductInfo>();
        var urls = Settings.Value.Products;

        if (!string.IsNullOrEmpty(urls.Portal))
            products.Add(new ProductInfo("Portal", urls.Portal));
        if (!string.IsNullOrEmpty(urls.Learn))
            products.Add(new ProductInfo("Learn", urls.Learn));
        if (!string.IsNullOrEmpty(urls.Safe))
            products.Add(new ProductInfo("Safe", urls.Safe));
        if (!string.IsNullOrEmpty(urls.Work))
            products.Add(new ProductInfo("Work", urls.Work));
        if (!string.IsNullOrEmpty(urls.Pulse))
            products.Add(new ProductInfo("Pulse", urls.Pulse));

        return products;
    }

    private bool IsCurrentProduct(string productName)
    {
        return string.Equals(Settings.Value.ProductName, productName,
            StringComparison.OrdinalIgnoreCase);
    }

    private void NavigateToProduct(string productName)
    {
        if (!IsCurrentProduct(productName))
        {
            SsoService.NavigateToProduct(productName);
        }
    }
}
