@* ============================================================================
   AG ONE PORTAL - App.razor Example
   ============================================================================
   Update your existing App.razor to include the CascadingAuthenticationState
   and AuthorizeRouteView. This ensures all routes require authentication.
   ============================================================================ *@

@using AgOne.Shared.Auth.Components
@using Microsoft.AspNetCore.Components.Authorization

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        @* User not authenticated - redirect to login *@
                        <AgOneRedirectToLogin />
                    }
                    else
                    {
                        @* User authenticated but not authorized for this page *@
                        <p>You are not authorized to access this resource.</p>
                    }
                </NotAuthorized>
                <Authorizing>
                    <div class="agone-auth-loading">
                        <p>Checking authorization...</p>
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <p role="alert">Sorry, there's nothing at this address.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
